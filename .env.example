# Copy to .env (or export these in your shell) before running in production.

# JWT signing key - MUST be replaced, at least 32 bytes.
MRA_SECRET_KEY=change-me-to-a-long-random-string

# Token lifetime in minutes.
MRA_ACCESS_TOKEN_EXPIRE_MINUTES=30

# SQLAlchemy database URL.
MRA_DATABASE_URL=sqlite:///./music.db

# Pagination / recommendation limits.
MRA_PAGE_SIZE_DEFAULT=20
MRA_PAGE_SIZE_MAX=100
MRA_RECOMMEND_LIMIT_DEFAULT=10
MRA_RECOMMEND_LIMIT_MAX=50

# How many songs the recommender scans per request.
MRA_MAX_SIMILAR_CANDIDATES=5000
